# ReportPortal API key (Bearer token)
# Get from: ReportPortal → Profile → API Keys
RP_API_KEY=your-reportportal-api-key

# ReportPortal base URL (no trailing slash)
RP_BASE_URL=https://reportportal.example.com

# Cache directory (optional, default: /tmp/must-gather-cache)
# MUST_GATHER_CACHE_DIR=/tmp/must-gather-cache
